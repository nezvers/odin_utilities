{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Tests",
            "request": "launch",
            "preLaunchTask": "Build Tests",
            "args": [],
            "cwd": "${workspaceFolder}",

            // Default for Linux
            "type": "cppvsdbg",
            "program": "${workspaceFolder}/${config:project_name}_test.exe",

            "linux": {
                "type": "lldb",
                "program": "${workspaceFolder}/${config:project_name}_test.bin"
            },
            "osx": {
                "type": "lldb",
                "program": "${workspaceFolder}/${config:project_name}_test.bin"
            }
        },
        {
            "name": "Run gen (needs the Unicode files)",
            "request": "launch",
            "preLaunchTask": "Build Gen",
            "args": ["references/ucd", "unicode_data/tables.odin"],
            "cwd": "${workspaceFolder}",

            "type": "cppvsdbg",
            "program": "${workspaceFolder}/${config:project_name}_gen.exe",

            "linux": {
                "type": "lldb",
                "program": "${workspaceFolder}/${config:project_name}_gen.bin"
            },
            "osx": {
                "type": "lldb",
                "program": "${workspaceFolder}/${config:project_name}_gen.bin"
            }
        }
    ]
}
