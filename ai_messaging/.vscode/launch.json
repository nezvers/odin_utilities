{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run amsg host (channel test)",
            "request": "launch",
            "preLaunchTask": "Build Amsg",
            "args": ["test", "--name", "alice", "--host"],
            "cwd": "${workspaceFolder}",

            // Default for Linux
            "type": "cppvsdbg",
            "program": "${workspaceFolder}/${config:project_name}_amsg.exe",

            "linux": {
                "type": "lldb",
                "program": "${workspaceFolder}/${config:project_name}_amsg.bin"
            },
            "osx": {
                "type": "lldb",
                "program": "${workspaceFolder}/${config:project_name}_amsg.bin"
            }
        },
