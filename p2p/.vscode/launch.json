{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run chat host",
            "request": "launch",
            "preLaunchTask": "Build Chat",
            "args": ["host", "alice"],
            "cwd": "${workspaceFolder}",

            // Default for Linux
            "type": "cppvsdbg",
            "program": "${workspaceFolder}/${config:project_name}_chat.exe",

            "linux": {
                "type": "lldb",
                "program": "${workspaceFolder}/${config:project_name}_chat.bin"
            },
            "osx": {
                "type": "lldb",
                "program": "${workspaceFolder}/${config:project_name}_chat.bin"
            }
