{
    "version": "2.0.0",
    "command": "",
    "args": [],
    "tasks": [
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "odin build demo_raylib -strict-style -vet -out:${config:project_name}.exe -debug",
            "group": "build",
            "linux": {
                "command": "odin build demo_raylib -strict-style -vet -out:${config:project_name}.bin -debug"
            },
            "osx": {
                "command": "odin build demo_raylib -strict-style -vet -out:${config:project_name}.bin -debug"
            }
        },
        {
            "label": "Build Debug Karl2D",
            "type": "shell",
            "command": "odin build demo_karl2d -strict-style -vet -out:${config:project_name}_karl2d.exe -debug",
            "group": "build",
            "linux": {
                "command": "odin build demo_karl2d -strict-style -vet -out:${config:project_name}_karl2d.bin -debug"
            },
            "osx": {
                "command": "odin build demo_karl2d -strict-style -vet -out:${config:project_name}_karl2d.bin -debug"
            }
        },
        {
            "label": "Build Module",
            "type": "shell",
            "command": "odin run ../tool/build_module -strict-style -vet -- module ../bin/arena-odin.wasm",
            "group": "build"
        },
        {
            "label": "Generate Schema",
            "type": "shell",
            "command": "odin run tool/schema -strict-style -vet",
            "group": "build"
        },
        {
            "label": "Build Tests",
            "type": "shell",
            "command": "odin build session -strict-style -vet -build-mode:test -out:${config:project_name}_test.exe -debug",
            "group": "build",
            "linux": {
                "command": "odin build session -strict-style -vet -build-mode:test -out:${config:project_name}_test.bin -debug"
            },
            "osx": {
                "command": "odin build session -strict-style -vet -build-mode:test -out:${config:project_name}_test.bin -debug"
            }
        },
        {
            "label": "Test",
            "type": "shell",
            "command": "odin test session -strict-style -vet && odin test demo_common -strict-style -vet",
            "group": "test"
        }
    ]
}
