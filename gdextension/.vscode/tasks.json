{
    "version": "2.0.0",
    "command": "",
    "args": [],
    "inputs": [
        {"id": "package", "type": "promptString", "description": "package folder of the extension", "default": "template"},
        {"id": "project", "type": "promptString", "description": "Godot project folder", "default": "template/godot_project"}
    ],
    "tasks": [
        {
            "label": "Check",
            "type": "shell",
            "command": "odin check . -no-entry-point -strict-style -vet",
            "group": "build"
        },
        {
            "label": "Build Extension Into Project",
            "type": "shell",
            "command": "odin run tool/build -- ${input:package} ${input:project} --import",
            "group": "build"
        },
        {
            "label": "Dump Godot Interface",
            "type": "shell",
            "command": "cd godot_api && godot --headless --dump-extension-api --dump-gdextension-interface",
            "group": "none"
        },
        {
            "label": "Test Example",
            "type": "shell",
            "command": "odin test godot_spacetimedb/godot_test -strict-style -vet",
            "group": "test"
        },
        {
            "label": "Build Example Tests",
            "type": "shell",
            "command": "odin build godot_spacetimedb/godot_test -strict-style -vet -build-mode:test -out:${config:project_name}_test.exe -debug",
            "group": "build",
            "linux": {
                "command": "odin build godot_spacetimedb/godot_test -strict-style -vet -build-mode:test -out:${config:project_name}_test.bin -debug"
            },
            "osx": {
                "command": "odin build godot_spacetimedb/godot_test -strict-style -vet -build-mode:test -out:${config:project_name}_test.bin -debug"
            }
        }
    ]
}
