{
    "version": "2.0.0",
    "command": "",
    "args": [],
    "tasks": [
        {
            "label": "Build Tests",
            "type": "shell",
            "command": "odin build . -strict-style -vet -build-mode:test -out:${config:project_name}_test.exe -debug",
            "group": "build",
            "linux": {
                "command": "odin build . -strict-style -vet -build-mode:test -out:${config:project_name}_test.bin -debug"
            },
            "osx": {
                "command": "odin build . -strict-style -vet -build-mode:test -out:${config:project_name}_test.bin -debug"
            }
        },
        {
            "label": "Build Tool",
            "type": "shell",
            "command": "odin build tool/build -strict-style -vet -out:${config:project_name}_tool.exe -debug",
            "group": "build",
            "linux": {
                "command": "odin build tool/build -strict-style -vet -out:${config:project_name}_tool.bin -debug"
            },
            "osx": {
                "command": "odin build tool/build -strict-style -vet -out:${config:project_name}_tool.bin -debug"
            }
        },
        {
            "label": "Test",
            "type": "shell",
            "command": "odin test . -strict-style -vet",
            "group": "test"
        },
        {
            "label": "Check",
            "type": "shell",
            "command": "odin check . -no-entry-point -strict-style -vet",
            "group": "test"
        }
    ]
}
