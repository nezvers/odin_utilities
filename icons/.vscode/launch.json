{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Tests",
            "request": "launch",
            "preLaunchTask": "Build Tests",
            "args": [],
            "cwd": "${workspaceFolder}",

            // Default for Linux
            "type": "cppvsdbg",
            "program": "${workspaceFolder}/${config:project_name}_test.exe",

            "linux": {
                "type": "lldb",
                "program": "${workspaceFolder}/${config:project_name}_test.bin"
            },
            "osx": {
                "type": "lldb",
                "program": "${workspaceFolder}/${config:project_name}_test.bin"
            }
        },
        {
            "name": "Run build (the icon font from the sprite)",
            "request": "launch",
            "preLaunchTask": "Build Tool",
            "args": [],
            "cwd": "${workspaceFolder}",

            // Default for Linux
            "type": "cppvsdbg",
            "program": "${workspaceFolder}/${config:project_name}_tool.exe",

            "linux": {
                "type": "lldb",
                "program": "${workspaceFolder}/${config:project_name}_tool.bin"
            },
            "osx": {
                "type": "lldb",
                "program": "${workspaceFolder}/${config:project_name}_tool.bin"
            }
        }
    ]
}
